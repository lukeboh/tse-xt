{
  "manifest_version": 3,
  "name": "TSE XT",
  "version": "0.5.17",
  "description": "Interface moderna com Glassmorfismo, 5 KPIs e usabilidade aprimorada para sistemas do Tribunal Superior Eleitoral (TSE).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://meuespaco.tse.jus.br/*",
    "*://*.tse.jus.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meuespaco.tse.jus.br/portalservidor2/EspelhoPontoMesAction_*",
        "*://*.tse.jus.br/portalservidor2/EspelhoPontoMesAction_*",
        "*://meuespaco.tse.jus.br/portalservidor2/EspelhoPontoDiaAction_*",
        "*://*.tse.jus.br/portalservidor2/EspelhoPontoDiaAction_*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/modules/version.js",
        "content/modules/settings.js",
        "content/modules/legalConfig.js",
        "content/modules/balanceCalc.js",
        "content/modules/authorizationScan.js",
        "content/modules/heAuthFetch.js",
        "content/modules/kpiExtractor.js",
        "content/modules/searchMenu.js",
        "content/modules/quickActions.js",
        "content/modules/navDrawer.js",
        "content/modules/domModernizer.js",
        "content/modules/pointAdjustmentModal.js",
        "content/modules/monthPlanner.js",
        "content/modules/lostHoursAudit.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
